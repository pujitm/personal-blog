---
import Layout from "../layouts/Commonplace.astro";
import Tile from "../components/commonplace/Tile.astro";
import { anchor, getCollage, type CollageItem } from "../lib/commonplace";

const { influences, output } = await getCollage();

// Things I love with things I've made sprinkled through.
const rank = (list: CollageItem[]) =>
    list.map((item, i) => ({ item, rank: (i + 0.5) / list.length }));
const items = [...rank(influences), ...rank(output)]
    .sort((a, b) => a.rank - b.rank)
    .map(({ item }) => item);
---

<Layout
    title="pujit · commonplace book"
    description="The music, stories, books and ideas I keep coming back to."
    view="grid"
>
    <main class="grid-page">
        <section class="collage" aria-label="Commonplace book">
            <div class="collage__grid">
                <figure class="tile anchor" style="--w:5;--rows:10;--ws:2;--hs:4">
                    <div class="face anchor__face">
                        <img
                            src={anchor.image.src}
                            alt={anchor.image.alt}
                            fetchpriority="high"
                            referrerpolicy="no-referrer"
                        />
                        <figcaption class="anchor__caption">Einstein, 1951</figcaption>
                    </div>
                </figure>

                <div class="tile intro" style="--w:4;--rows:6;--ws:2;--hs:4">
                    <div class="face intro__face">
                        <p class="kicker">A commonplace book</p>
                        <h1>
                            The pieces, pictures, stories and ideas I keep
                            coming back to.
                        </h1>
                        <p>
                            I'm Pujit, a software engineer working on <a
                                href="https://unraid.net/">Unraid</a
                            >. Click a score to hear it.
                        </p>
                    </div>
                </div>

                {items.map((item, i) => <Tile item={item} tape={i % 5 === 2} />)}
            </div>
        </section>
    </main>
</Layout>

<style>
    .grid-page {
        padding: 0.5rem var(--gutter) 0;
    }

    .collage {
        container: collage / inline-size;
    }

    .collage__grid {
        --cols: 2;
        --gap: clamp(0.6rem, 1.2vw, 1rem);
        display: grid;
        grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
        /* Half-column rows: shapes are columns x (rows / 2). */
        grid-auto-rows: calc((100cqi - (var(--cols) - 1) * var(--gap)) / var(--cols) / 2 - var(--gap) / 2);
        grid-auto-flow: row dense;
        gap: var(--gap);
    }

    .collage__grid > :global(*) {
        grid-column: span var(--ws);
        grid-row: span var(--hs);
    }

    @container collage (width >= 36rem) {
        .collage__grid {
            --cols: 6;
        }

        .collage__grid > :global(*) {
            grid-column: span var(--w);
            grid-row: span var(--rows);
        }
    }

    @container collage (width >= 52rem) {
        .collage__grid {
            --cols: 9;
        }
    }

    @container collage (width >= 72rem) {
        .collage__grid {
            --cols: 12;
        }
    }

    .collage__grid > :global(.tile:not(.anchor, .intro):hover) {
        translate: 0 -2px;
        rotate: -0.4deg;
    }

    /* Einstein */
    .anchor {
        margin: 0;
    }

    .anchor__face {
        padding: 0.6rem 0.6rem 2.6rem;
        background: #fbfaf6;
        rotate: -1.2deg;
    }

    .anchor__face img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% 30%;
        filter: grayscale(1) contrast(1.05);
    }

    .anchor__caption {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0.45rem;
        text-align: center;
        font-family: var(--font-hand);
        font-size: 1.5rem;
        color: #2b2a27;
    }

    .intro__face {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        gap: 0.75rem;
        padding: clamp(1rem, 4cqi, 1.75rem);
        background: transparent;
        box-shadow: none;
        overflow: visible;
    }

    .intro h1 {
        margin: 0;
        font-size: clamp(1.4rem, 7cqi, 2.4rem);
        font-weight: 400;
        line-height: 1.12;
        letter-spacing: -0.015em;
        text-wrap: balance;
    }

    .intro p {
        margin: 0;
        color: var(--ink-2);
    }

    .intro a {
        text-decoration-color: var(--accent);
        text-underline-offset: 3px;
    }
</style>
