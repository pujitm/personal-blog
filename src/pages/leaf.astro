---
import Layout from "../layouts/Commonplace.astro";
import Tile from "../components/commonplace/Tile.astro";
import { KIND_LABELS, anchor, getCollage, type ItemKind } from "../lib/commonplace";
import { ANCHOR_SIZE, CENTER, bounds, insigniaPath, layoutLeaf } from "../lib/leaf";

const { influences, output, all } = await getCollage();
const placed = layoutLeaf(influences, output);
const box = bounds([...placed.spiral, ...placed.leaf]);

// Design units -> world pixels. Big enough that zoomed-in text stays sharp.
const SCALE = 1.6;
const px = (n: number) => +(n * SCALE).toFixed(1);
const tileStyle = (p: { x: number; y: number; width: number; height: number; tilt: number }) =>
    `left:${px(p.x - p.width / 2)}px;top:${px(p.y - p.height / 2)}px;width:${px(p.width)}px;height:${px(p.height)}px;--tilt:${p.tilt.toFixed(1)}deg`;

const camera = {
    box: { x: px(box.left), y: px(box.top), w: px(box.right - box.left), h: px(box.bottom - box.top) },
    center: { x: px(CENTER.x), y: px(CENTER.y) },
    anchor: px(ANCHOR_SIZE),
};

const groups = Object.entries(
    Object.groupBy(all, (item) => item.kind) as Record<ItemKind, typeof all>,
);
---

<Layout
    title="pujit · commonplace book"
    description="The music, stories, books and ideas I keep coming back to, arranged as a leaf."
    view="leaf"
>
    <main>
        <section class="leaf" aria-label="Commonplace book, arranged as the Hidden Leaf insignia" data-camera={JSON.stringify(camera)}>
            <div class="leaf__stage">
                <div class="leaf__world">
                    <svg class="leaf__ink" viewBox="0 0 1000 1000" aria-hidden="true">
                        <path d={insigniaPath()} />
                    </svg>
                    <figure
                        class="leaf__anchor"
                        style={`left:${px(CENTER.x - ANCHOR_SIZE / 2)}px;top:${px(CENTER.y - ANCHOR_SIZE * 0.62)}px;width:${px(ANCHOR_SIZE)}px;height:${px(ANCHOR_SIZE * 1.12)}px`}
                    >
                        <img
                            src={anchor.image.src}
                            alt={anchor.image.alt}
                            fetchpriority="high"
                            referrerpolicy="no-referrer"
                        />
                        <figcaption>Einstein, 1951</figcaption>
                    </figure>
                    {
                        influences.map((item, i) => (
                            <Tile
                                item={item}
                                mode="leaf"
                                tape={i % 6 === 3}
                                class="leaf__tile"
                                style={tileStyle(placed.spiral[i])}
                            />
                        ))
                    }
                    {
                        output.map((item, i) => (
                            <Tile
                                item={item}
                                mode="leaf"
                                class="leaf__tile"
                                style={tileStyle(placed.leaf[i])}
                            />
                        ))
                    }
                </div>
                <p class="leaf__hint" aria-hidden="true">Scroll to fall in</p>
            </div>
        </section>

        <div class="leaf-preview" aria-hidden="true"></div>

        <section class="index" aria-labelledby="index-title">
            <h2 id="index-title" class="kicker">Everything in the leaf</h2>
            <div class="index__groups">
                {
                    groups.map(([kind, items]) => (
                        <div class="index__group">
                            <h3>{KIND_LABELS[kind]}</h3>
                            <ul>
                                {items.map((item) => (
                                    <li>
                                        <a
                                            href={item.href}
                                            target={item.external ? "_blank" : undefined}
                                            rel={item.external ? "noopener" : undefined}
                                        >
                                            {item.title}
                                        </a>
                                        {item.subtitle && <span> · {item.subtitle}</span>}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </section>
    </main>
</Layout>

<style>
    .leaf {
        position: relative;
        height: 420vh;
        margin-top: -4.5rem; /* tuck under the header so the leaf owns the first screen */
    }

    .leaf__stage {
        position: sticky;
        top: 0;
        height: 100vh;
        height: 100svh;
        overflow: hidden;
    }

    .leaf__world {
        position: absolute;
        left: 0;
        top: 0;
        width: 1600px;
        height: 1600px;
        transform-origin: 0 0;
        /* Until the script positions it, roughly fit it. */
        transform: scale(0.5);
    }

    .leaf__ink {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .leaf__ink path {
        fill: none;
        stroke: var(--accent);
        stroke-opacity: 0.22;
        stroke-width: 34;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .leaf__anchor {
        position: absolute;
        z-index: 1;
        margin: 0;
        padding: 10px 10px 46px;
        background: #fbfaf6;
        box-shadow: var(--shadow-lift);
        rotate: calc(-2deg - var(--spin, 0deg));
    }

    .leaf__anchor img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% 28%;
        filter: grayscale(1) contrast(1.05);
        background: #e8e4da;
    }

    .leaf__anchor figcaption {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 8px;
        text-align: center;
        font-family: var(--font-hand);
        font-size: 26px;
        color: #2b2a27;
    }

    .leaf__world :global(.leaf__tile) {
        position: absolute;
        rotate: calc(var(--tilt, 0deg) - var(--spin, 0deg));
    }

    .leaf__world :global(.leaf__tile:hover),
    .leaf__world :global(.leaf__tile:focus-visible) {
        z-index: 5;
        scale: 1.06;
    }

    .leaf__hint {
        position: absolute;
        left: 50%;
        bottom: 1.5rem;
        translate: -50% 0;
        margin: 0;
        font-family: var(--font-hand);
        font-size: 1.5rem;
        color: var(--ink-2);
        opacity: calc(1 - var(--progress, 0) * 8);
        pointer-events: none;
    }

    .leaf__hint::after {
        content: " ↓";
        font-family: var(--font-serif);
    }

    /* Hover preview: the same tile, bigger, so its container queries open it up. */
    .leaf-preview {
        position: fixed;
        z-index: 40;
        left: 0;
        top: 0;
        pointer-events: none;
        opacity: 0;
        scale: 0.96;
        transition:
            opacity 0.14s ease,
            scale 0.14s ease;
    }

    .leaf-preview[data-open] {
        opacity: 1;
        scale: 1;
    }

    .leaf-preview :global(.tile) {
        position: static;
        width: 100%;
        height: 100%;
        rotate: none;
        scale: none;
    }

    .leaf-preview :global(.face) {
        box-shadow:
            0 2px 3px rgb(40 25 5 / 0.12),
            0 30px 60px -20px rgb(40 25 5 / 0.55);
    }

    .index {
        padding: 4rem var(--gutter) 0;
    }

    .index__groups {
        margin-top: 1.5rem;
        columns: 15rem;
        column-gap: 2.5rem;
    }

    .index__group {
        break-inside: avoid;
        margin-bottom: 2rem;
    }

    .index h3 {
        margin: 0 0 0.5rem;
        font-size: 1.25rem;
        font-weight: 500;
    }

    .index ul {
        margin: 0;
        padding: 0;
        list-style: none;
        font-size: 0.9375rem;
        line-height: 1.5;
    }

    .index li span {
        color: var(--ink-3);
        font-style: italic;
    }

    .index a {
        text-decoration-color: var(--rule);
        text-underline-offset: 3px;
    }

    .index a:hover {
        text-decoration-color: var(--accent);
    }
</style>

<script>
    import { renderIncipit } from "../scripts/incipits";

    type Camera = {
        box: { x: number; y: number; w: number; h: number };
        center: { x: number; y: number };
        anchor: number;
    };

    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    function initLeaf() {
        const leaf = document.querySelector<HTMLElement>(".leaf");
        const stage = leaf?.querySelector<HTMLElement>(".leaf__stage");
        const world = leaf?.querySelector<HTMLElement>(".leaf__world");
        if (!leaf || !stage || !world) return;
        const camera: Camera = JSON.parse(leaf.dataset.camera!);
        const still = matchMedia("(prefers-reduced-motion: reduce)");

        let frame = 0;
        const update = () => {
            frame = 0;
            const vw = stage.clientWidth;
            const vh = stage.clientHeight;
            const scrollable = leaf.offsetHeight - vh;
            const progress = Math.min(1, Math.max(0, -leaf.getBoundingClientRect().top / scrollable));
            const t = ease(progress);

            // Start with the whole leaf in view; end with Einstein filling it.
            const { box, center } = camera;
            const fit = Math.min((vw * 0.94) / box.w, (vh * 0.9) / box.h);
            const close = (Math.min(vw, vh) * 0.62) / camera.anchor;
            const scale = fit * (close / fit) ** t;

            // Where the center lands on screen when the whole leaf is fit...
            const startX = vw / 2 + (center.x - (box.x + box.w / 2)) * fit;
            const startY = vh / 2 + (center.y - (box.y + box.h / 2)) * fit;
            // ...and it drifts to the middle as we fall in.
            const x = lerp(startX, vw / 2, Math.min(1, t * 1.6));
            const y = lerp(startY, vh / 2, Math.min(1, t * 1.6));
            const spin = still.matches ? 0 : -150 * t;

            world.style.transform = `translate(${x}px, ${y}px) scale(${scale}) rotate(${spin}deg) translate(${-center.x}px, ${-center.y}px)`;
            world.style.setProperty("--spin", `${spin}deg`);
            leaf.style.setProperty("--progress", String(progress));
        };
        const schedule = () => (frame ||= requestAnimationFrame(update));
        update();
        addEventListener("scroll", schedule, { passive: true });
        addEventListener("resize", schedule);
        const stopPreview = initPreview(world);
        document.addEventListener(
            "astro:before-swap",
            () => {
                cancelAnimationFrame(frame);
                removeEventListener("scroll", schedule);
                removeEventListener("resize", schedule);
                stopPreview?.();
            },
            { once: true },
        );
    }

    function initPreview(world: HTMLElement) {
        const preview = document.querySelector<HTMLElement>(".leaf-preview");
        if (!preview || !matchMedia("(hover: hover)").matches) return;
        let current: HTMLElement | null = null;
        let timer = 0;

        const show = (tile: HTMLElement) => {
            current = tile;
            const w = Number(tile.style.getPropertyValue("--w")) || 3;
            const rows = Number(tile.style.getPropertyValue("--rows")) || 6;
            const h = rows / 2;
            const base = Math.min(19 * 16, innerWidth * 0.36);
            const width = base * Math.sqrt(w / h);
            const height = base / Math.sqrt(w / h);

            const clone = tile.cloneNode(true) as HTMLElement;
            clone.removeAttribute("style");
            clone.removeAttribute("href");
            clone.querySelectorAll("[data-incipit]").forEach((el) => el.removeAttribute("data-rendered"));
            preview.replaceChildren(clone);
            preview.style.width = `${width}px`;
            preview.style.height = `${height}px`;
            clone.querySelectorAll<HTMLElement>("[data-incipit]").forEach(renderIncipit);

            const rect = tile.getBoundingClientRect();
            const gap = 18;
            const right = rect.right + gap + width < innerWidth - 12;
            const left = right ? rect.right + gap : Math.max(12, rect.left - gap - width);
            const top = Math.min(
                Math.max(12, rect.top + rect.height / 2 - height / 2),
                innerHeight - height - 12,
            );
            preview.style.translate = `${left}px ${top}px`;
            preview.setAttribute("data-open", "");
        };

        const hide = () => {
            current = null;
            clearTimeout(timer);
            preview.removeAttribute("data-open");
        };

        world.addEventListener("pointerover", (event) => {
            const tile = (event.target as HTMLElement).closest<HTMLElement>(".leaf__tile");
            if (!tile || tile === current) return;
            clearTimeout(timer);
            timer = window.setTimeout(() => show(tile), 70);
        });
        world.addEventListener("pointerleave", hide);
        world.addEventListener("pointerout", (event) => {
            const to = (event.relatedTarget as HTMLElement | null)?.closest(".leaf__tile");
            if (!to) hide();
        });
        world.addEventListener("focusin", (event) => {
            const tile = (event.target as HTMLElement).closest<HTMLElement>(".leaf__tile");
            if (tile) show(tile);
        });
        world.addEventListener("focusout", hide);
        addEventListener("scroll", hide, { passive: true });
        return () => removeEventListener("scroll", hide);
    }

    document.addEventListener("astro:page-load", initLeaf);
</script>
