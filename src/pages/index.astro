---
import Layout from "../layouts/Commonplace.astro";
import LeafCollage from "../components/commonplace/LeafCollage.astro";
import { KIND_LABELS, anchor, getCollage, type CollageItem, type ItemKind } from "../lib/commonplace";
import { imageUrl } from "../lib/images";
import { SITE_DESCRIPTION } from "../config";

const { leaf, ground, everything } = await getCollage();

const groups = Object.entries(
    Object.groupBy(everything, (item) => item.kind) as Record<ItemKind, CollageItem[]>,
);
---

<Layout title="pujit mehrotra" description={SITE_DESCRIPTION}>
    <main class="home">
        <section class="hero" aria-labelledby="hello">
            <div class="hero__words">
                <h1 id="hello">Hi, I'm Pujit.</h1>
                <p>
                    I'm a software engineer working on <a href="https://unraid.net/">Unraid</a>.
                    I once led engineering at a small company called Kachow until it was acquired.
                </p>
                <p>
                    Below is my commonplace book: the music, stories, books and ideas I keep
                    coming back to, and a few things I've made. Scroll down into the leaf; click sheet music to hear it.
                </p>
            </div>

            <figure class="hero__photo">
                <span class="hero__tape hero__tape--left" aria-hidden="true"></span>
                <span class="hero__tape hero__tape--right" aria-hidden="true"></span>
                <img
                    src={imageUrl(anchor.image.src)}
                    width={anchor.image.width}
                    height={anchor.image.height}
                    alt={anchor.image.alt}
                    fetchpriority="high"
                    referrerpolicy="no-referrer"
                />
                <figcaption>Einstein on his 72nd birthday, 1951</figcaption>
            </figure>
        </section>

        <div id="collage" class="home__collage">
            <LeafCollage leaf={leaf} ground={ground} />
        </div>

        <section class="index" aria-labelledby="index-title">
            <h2 id="index-title">Everything above, as a list</h2>
            <div class="index__groups">
                {
                    groups.map(([kind, items]) => (
                        <div class="index__group">
                            <h3>{KIND_LABELS[kind]}</h3>
                            <ul>
                                {items.map((item) => (
                                    <li>
                                        <a
                                            href={item.href}
                                            target={item.external ? "_blank" : undefined}
                                            rel={item.external ? "noopener" : undefined}
                                        >
                                            {item.title}
                                        </a>
                                        {item.subtitle && <span> · {item.subtitle}</span>}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </section>
    </main>
</Layout>

<style>
    .home {
        position: relative;
        padding: 0 var(--gutter);
        overflow-x: clip;
    }

    /* ---- hello */

    .hero {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-items: center;
        gap: 3rem;
        min-height: calc(100svh - 5rem);
        padding-bottom: 4rem;
    }

    @media (max-width: 55.99rem) {
        .hero {
            gap: 2.25rem;
            padding-top: 1rem;
        }

        .hero__photo {
            width: min(72%, 22rem, 46svh);
        }
    }

    @media (min-width: 56rem) {
        .hero {
            grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
            gap: 2rem;
        }

    }

    .hero__words {
        max-width: 34rem;
    }

    .hero h1 {
        margin: 0 0 1.75rem;
        font-size: clamp(3.4rem, 9vw, 7.75rem);
        font-weight: 400;
        line-height: 0.92;
        letter-spacing: -0.035em;
    }

    .hero p {
        margin: 0 0 1rem;
        font-size: clamp(1.125rem, 1.6vw, 1.375rem);
        line-height: 1.5;
        color: var(--ink-2);
    }

    .hero a {
        color: var(--ink);
        text-decoration-color: var(--accent);
        text-decoration-thickness: 2px;
        text-underline-offset: 4px;
    }

    .hero__photo {
        position: relative;
        justify-self: center;
        width: min(100%, 34rem, 62svh);
        order: -1; /* Einstein first, then hello */
        margin: 0;
        padding: 3.2% 3.2% 13%;
        background: #fbfaf5;
        rotate: 3deg;
        box-shadow:
            0 2px 2px rgb(40 25 5 / 0.18),
            0 30px 50px -22px rgb(40 25 5 / 0.6);
    }

    .hero__photo img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 960 / 1226;
        object-fit: cover;
        background: #d8d2c6;
        filter: contrast(1.06);
    }

    .hero__photo figcaption {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 3.2%;
        font-family: var(--font-hand);
        font-size: clamp(1.25rem, 2.2vw, 1.75rem);
        font-weight: 600;
        text-align: center;
        color: #2b2a27;
    }

    .hero__tape {
        position: absolute;
        z-index: 2;
        top: -1rem;
        width: 7.5rem;
        height: 2rem;
        background: linear-gradient(rgb(255 255 255 / 0.3), transparent 50%), var(--tape);
        clip-path: polygon(0 8%, 4% 0, 8% 10%, 12% 0, 88% 0, 92% 12%, 96% 0, 100% 10%, 100% 90%, 96% 100%, 92% 88%, 88% 100%, 12% 100%, 8% 90%, 4% 100%, 0 92%);
        mix-blend-mode: multiply;
    }

    .hero__tape--left {
        left: -2.25rem;
        rotate: -38deg;
        top: 0.5rem;
    }

    .hero__tape--right {
        right: -2.25rem;
        rotate: 40deg;
        top: 0.75rem;
    }

    @media (prefers-color-scheme: dark) {
        .hero__tape {
            mix-blend-mode: normal;
            opacity: 0.8;
        }
    }

    /* ---- collage: full bleed */

    .home__collage {
        margin: 0 calc(-1 * var(--gutter));
    }

    /* ---- list */

    .index {
        position: relative;
        z-index: 1;
        max-width: 72rem;
        margin: 0 auto;
        padding: 3rem 0 0;
        border-top: 1px solid var(--rule);
    }

    .index h2 {
        margin: 0;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-3);
    }

    .index__groups {
        margin-top: 1.5rem;
        columns: 15rem;
        column-gap: 2.5rem;
    }

    .index__group {
        break-inside: avoid;
        margin-bottom: 2rem;
    }

    .index h3 {
        margin: 0 0 0.5rem;
        font-size: 1.25rem;
        font-weight: 500;
    }

    .index ul {
        margin: 0;
        padding: 0;
        list-style: none;
        font-size: 0.9375rem;
        line-height: 1.5;
    }

    .index li span {
        color: var(--ink-3);
        font-style: italic;
    }

    .index a {
        text-decoration-color: var(--rule);
        text-underline-offset: 3px;
    }

    .index a:hover {
        text-decoration-color: var(--accent);
    }
</style>
