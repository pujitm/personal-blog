<aside id="now-playing" class="now-playing" aria-label="Now playing" hidden>
    <div class="now-playing__frame">
        <div id="now-playing-video"></div>
    </div>
    <div class="now-playing__meta">
        <div>
            <a id="now-playing-title" class="now-playing__title" href="#"></a>
            <p id="now-playing-sub" class="now-playing__sub"></p>
        </div>
        <div class="now-playing__controls">
            <button id="now-playing-prev" type="button" aria-label="Previous movement" hidden>⏮</button>
            <button id="now-playing-toggle" type="button" aria-label="Pause">❚❚</button>
            <button id="now-playing-next" type="button" aria-label="Next movement" hidden>⏭</button>
            <button id="now-playing-close" type="button" aria-label="Stop and close">✕</button>
        </div>
    </div>
</aside>

