---
import Incipit from "./Incipit.astro";
import {
    KIND_LABELS,
    formatDate,
    tracksFor,
    type CollageItem,
} from "../../lib/commonplace";

export interface Props {
    item: CollageItem;
    /**
     * "grid": music incipits play on click, everything else links out.
     * "leaf": the whole tile is a link; the leaf page handles previews.
     */
    mode?: "grid" | "leaf";
    /** A strip of tape across the top. */
    tape?: boolean;
    class?: string;
    style?: string;
}

const { item, mode = "grid", tape, class: className, style } = Astro.props;
const label = KIND_LABELS[item.kind];

// Pick black or white text for a book's cover color.
const inkFor = (hex = "#333") => {
    const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
    const lum = 0.2126 * r + 0.7152 * g + 0.0722 * b;
    return lum > 0.55 ? "#1c1a17" : "#f7f2e8";
};

const music = item.music;
const tracks = music ? tracksFor(item.id, music) : undefined;
const firstMovement = music?.movements[0];
const shelfLabel = item.shelf === "favorite" ? "A favorite" : "Reading now";
const linkText = item.external ? "Visit ↗" : "Read →";
const playsInPlace = mode === "grid" && item.kind === "music";
const Root = playsInPlace ? "div" : "a";

// Grid footprint. Rows are half a column tall so shapes keep their aspect
// ratio when they collapse to two columns on phones.
const { w, h } = item.shape;
const ws = w >= 3 ? 2 : 1;
const footprint = `--w:${w};--rows:${h * 2};--ws:${ws};--hs:${Math.max(2, Math.round((2 * h * ws) / w))}`;
const linkAttrs = playsInPlace
    ? {}
    : {
          href: item.href,
          target: item.external ? "_blank" : undefined,
          rel: item.external ? "noopener" : undefined,
      };
---

<Root
    class:list={["tile", className]}
    data-tile
    data-kind={item.kind}
    data-href={item.href}
    data-count={item.images.length || undefined}
    data-tape={tape ? "" : undefined}
    style={`${footprint};${style ?? ""}`}
    {...linkAttrs}
>
    {
        item.kind === "music" && music ? (
            <div class="face face--music">
                <header class="music__head">
                    <span class="kicker">{music.composer}</span>
                    {playsInPlace ? (
                        <a class="music__title" href={item.href}>
                            {item.title}
                        </a>
                    ) : (
                        <strong class="music__title">{item.title}</strong>
                    )}
                </header>
                {playsInPlace ? (
                    <Incipit
                        abc={firstMovement?.incipit}
                        label={music.work}
                        marking={`${firstMovement?.title} · ${music.key}`}
                        tracks={tracks}
                        piece={item.id}
                    />
                ) : (
                    <Incipit
                        abc={firstMovement?.incipit}
                        label={music.work}
                        marking={`${firstMovement?.title} · ${music.key}`}
                    />
                )}
                <footer class="music__foot">
                    <span class="music__performer">{music.performer}</span>
                    {music.movements.length > 1 && (
                        <span class="music__count">
                            {music.movements.length} movements
                        </span>
                    )}
                </footer>
                {item.note && <p class="note">{item.note}</p>}
            </div>
        ) : item.kind === "book" && !item.images.length ? (
            <div
                class="face face--book"
                style={`--cover:${item.color ?? "#3b3a36"};--cover-ink:${inkFor(item.color)}`}
            >
                <span class="book__shelf">{shelfLabel}</span>
                <strong class="book__title">{item.title}</strong>
                <span class="book__author">{item.subtitle}</span>
            </div>
        ) : item.kind === "work" || item.kind === "writing" ? (
            <div class="face face--card">
                <span class="kicker">
                    {item.date && formatDate(item.date)} · {label}
                </span>
                <strong class="card__title">{item.title}</strong>
                {item.description && (
                    <p class="card__desc">{item.description}</p>
                )}
                <span class="card__go">{linkText}</span>
            </div>
        ) : (
            <figure class="face face--image">
                <div class="image__frames">
                    {item.images.slice(0, 2).map((image) => (
                        <img
                            src={image.src}
                            data-fallback={image.fallback}
                            alt={image.alt}
                            loading="lazy"
                            decoding="async"
                            referrerpolicy="no-referrer"
                            style={image.focus && `object-position:${image.focus}`}
                            onerror="window.commonplaceImageError?.(this)"
                        />
                    ))}
                </div>
                <figcaption>
                    <span class="kicker">{label}</span>
                    <strong class="image__title">{item.title}</strong>
                    {item.subtitle && (
                        <span class="image__subtitle">{item.subtitle}</span>
                    )}
                </figcaption>
                {item.note && <p class="note">{item.note}</p>}
            </figure>
        )
    }
</Root>
