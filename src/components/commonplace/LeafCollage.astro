---
// The collage. The Hidden Leaf is built out of the things themselves, in
// their own colors, theme after theme along one line: the heroic-moral down
// the stem and round the leaf, the tragic-psychological back along the outer
// turn, the romantic-spiritual curling in to the eye. Scrolling breaks the
// spell and everything settles into a board, one band per theme. Hover
// anything to lift it; click to open it or hear it.
import CollagePiece from "./CollagePiece.astro";
import { colorOf, type Laid } from "../../lib/commonplace";
import { board, formSymbol, type Thing } from "../../lib/leaf";
import { themeLabel } from "../../data/collage";
import "../../styles/collage.css";

export interface Props {
    /** Everything, by theme, in the order it runs (the last sits at the eye). */
    items: Laid[];
}

const { items } = Astro.props;

// Base sizes, before the symbol scales its pieces to fit.
const AREA = 9000;
const SIZE: Record<string, [number, number]> = {
    music: [180, 64],
    wide: [205, 72],
    cover: [72, 106],
    card: [116, 77],
    square: [84, 84],
};

const things: Thing[] = items.map((laid) => {
    const { item } = laid;
    const form = item.music ? "music" : laid.form;
    let [w, h] = SIZE[form] ?? [0, 0];
    if (form === "cover" && laid.aspect) {
        const aspect = Math.min(0.8, Math.max(0.56, laid.aspect));
        w = Math.sqrt(w * h * aspect);
        h = w / aspect;
    }
    if (form === "image") {
        const aspect = Math.min(1.9, Math.max(0.62, (laid.aspect ?? 1.33) * (item.images.length === 2 ? 2 : 1)));
        w = Math.sqrt(AREA * aspect);
        h = AREA / w;
    }
    return { id: item.id, form: laid.form, w, h, theme: item.theme };
});

const symbol = formSymbol(things);
const width = symbol?.width ?? 1000;
const height = symbol?.height ?? 1000;

// The board: a band per theme, each under its heading.
const sizes = items.map((laid) => {
    const f = symbol?.formed.get(laid.item.id);
    return { w: f?.w ?? 100, h: f?.h ?? 100, wide: laid.form === "wide" };
});
const starts = items.flatMap((laid, i) => (i === 0 || items[i - 1].item.theme !== laid.item.theme ? [i] : []));
const HEADING = { desk: width * 0.052, phone: width * 0.15 };
const desk = board(sizes, width, 6, width * 0.016, starts.map((start) => ({ start, heading: HEADING.desk })));
const phone = board(sizes, width, 2, width * 0.024, starts.map((start) => ({ start, heading: HEADING.phone })));

const hexRgb = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
const ink = (hex: string) => {
    const [r, g, b] = hexRgb(hex).map((c) => c / 255);
    return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.55 ? "#1c1a17" : "#f7f2e8";
};
const PAPER: Record<string, string> = {
    music: "#efe3c6",
    card: "#fdfcf8",
    square: "#f6e27a",
    image: "#fbfaf5",
    wide: "#1a1411",
};
const toHex = (rgb: number[]) => `#${rgb.map((c) => Math.round(c).toString(16).padStart(2, "0")).join("")}`;

const pieces = items.map((laid, i) => {
    const f = symbol?.formed.get(laid.item.id) ?? { x: width / 2, y: height / 2, w: 100, h: 100, rot: 0, z: 1 };
    const d = desk.settled[i];
    const p = phone.settled[i];
    const form = laid.item.music ? "music" : laid.form;
    // Covers show their own color while the picture loads.
    const paper = form === "cover" ? toHex(colorOf(laid)) : PAPER[form] ?? "#fbfaf5";
    const vars: Record<string, string | number> = {
        "--x0": f.x.toFixed(1),
        "--y0": f.y.toFixed(1),
        "--w": f.w.toFixed(1),
        "--h": f.h.toFixed(1),
        "--r0": f.rot.toFixed(1),
        "--z": f.z,
        "--dxD": (d.x - f.x).toFixed(1),
        "--dyD": (d.y - f.y).toFixed(1),
        "--sD": d.scale.toFixed(3),
        "--dxM": (p.x - f.x).toFixed(1),
        "--dyM": (p.y - f.y).toFixed(1),
        "--sM": p.scale.toFixed(3),
        // Things near the top of the board settle first, like pages landing.
        "--delayD": ((d.y / desk.height) * 0.5 + (i % 7) * 0.008).toFixed(3),
        "--delayM": ((p.y / phone.height) * 0.5 + (i % 7) * 0.008).toFixed(3),
        "--paper": paper,
        "--ink": ink(paper),
    };
    return { laid, style: css(vars) };
});

// Each theme's name: a note in the margin beside its stretch of the leaf,
// then the heading over its band on the board.
const LABEL = { formed: (symbol?.T ?? 100) * 0.34, desk: HEADING.desk * 0.62, phone: HEADING.phone * 0.6 };
const labels = starts.map((start, k) => {
    const theme = items[start].item.theme;
    const text = themeLabel(theme);
    // Keep the note inside the world, so it isn't cut off on a narrow screen.
    const half = text.length * LABEL.formed * 0.3;
    const at = symbol?.labels.find((label) => label.theme === theme) ?? { x: width / 2, y: height / 2 };
    const x = Math.min(width - half - 10, Math.max(half + 10, at.x));
    const y = Math.min(height - LABEL.formed, Math.max(LABEL.formed, at.y));
    const gapD = width * 0.016;
    const gapM = width * 0.024;
    return {
        theme,
        text,
        style: css({
            "--x0": x.toFixed(1),
            "--y0": y.toFixed(1),
            "--f0": LABEL.formed.toFixed(1),
            "--xD": gapD.toFixed(1),
            "--yD": desk.headings[k].toFixed(1),
            "--fD": LABEL.desk.toFixed(1),
            "--hD": HEADING.desk.toFixed(1),
            "--xM": gapM.toFixed(1),
            "--yM": phone.headings[k].toFixed(1),
            "--fM": LABEL.phone.toFixed(1),
            "--hM": HEADING.phone.toFixed(1),
            "--delayD": ((desk.headings[k] / desk.height) * 0.5).toFixed(3),
            "--delayM": ((phone.headings[k] / phone.height) * 0.5).toFixed(3),
        }),
    };
});

function css(vars: Record<string, string | number>) {
    return Object.entries(vars)
        .map(([k, v]) => `${k}:${v}`)
        .join(";");
}
---

<section
    class="leaf"
    aria-label="Commonplace book"
    data-width={width.toFixed(0)}
    data-height={height.toFixed(0)}
    data-desk-height={desk.height.toFixed(0)}
    data-phone-height={phone.height.toFixed(0)}
>
    <div class="leaf__stage">
        <div class="leaf__world" style={`width:${width.toFixed(0)}px;height:${height.toFixed(0)}px`}>
            {
                labels.map((label) => (
                    <>
                        <h3 class="leaf__theme" data-theme={label.theme} style={label.style}>
                            <span>{label.text}</span>
                        </h3>
                        {pieces
                            .filter((piece) => piece.laid.item.theme === label.theme)
                            .map((piece) => (
                                <CollagePiece laid={piece.laid} style={piece.style} />
                            ))}
                    </>
                ))
            }
        </div>
        <p class="leaf__hint" aria-hidden="true">scroll, and it all falls into place</p>
    </div>
</section>

<script>
    const clamp01 = (t: number) => Math.min(1, Math.max(0, t));
    const smooth = (t: number) => t * t * (3 - 2 * t);

    function initCollage() {
        const leaf = document.querySelector<HTMLElement>(".leaf");
        const stage = leaf?.querySelector<HTMLElement>(".leaf__stage");
        const world = leaf?.querySelector<HTMLElement>(".leaf__world");
        if (!leaf || !stage || !world) return;
        const phone = matchMedia("(max-width: 40rem)");
        const still = matchMedia("(prefers-reduced-motion: reduce)");
        const W = Number(leaf.dataset.width);
        const H = Number(leaf.dataset.height);

        // Scroll budget: hold on the leaf, let everything settle, then pan the board.
        let geometry = { vw: 0, vh: 0, hold: 0, settle: 0, pan: 0, formed: 1, board: 1 };
        const measure = () => {
            const vw = stage.clientWidth;
            const vh = innerHeight;
            const boardHeight = Number(phone.matches ? leaf.dataset.phoneHeight : leaf.dataset.deskHeight);
            const formed = Math.min((vw * 0.94) / W, (vh * 0.88) / H);
            const board = Math.max(formed, Math.min(vw * 0.94, 1320) / W);
            const hold = vh * 0.45;
            const settle = vh * (still.matches ? 0.6 : 2.4);
            const pan = Math.max(0, boardHeight * board + 140 - vh);
            geometry = { vw, vh, hold, settle, pan, formed, board };
            leaf.style.height = `${vh + hold + settle + pan + vh * 0.25}px`;
        };

        let frame = 0;
        let idle = 0;
        const update = () => {
            frame = 0;
            const { vw, vh, hold, settle, pan, formed, board } = geometry;
            const s = Math.max(0, -leaf.getBoundingClientRect().top);
            const order = clamp01((s - hold) / settle);
            const e = smooth(order);
            const panned = clamp01((s - hold - settle) / Math.max(1, pan)) * pan;

            // From the whole leaf in view to the top of the board, then down it.
            const scale = formed * (board / formed) ** e;
            const boardTop = vh / 2 / board - 70 / board;
            const fx = W / 2;
            const fy = H / 2 + (boardTop - H / 2) * e + panned / board;

            world.style.transform = `translate(${vw / 2 - fx * scale}px, ${vh / 2 - fy * scale}px) scale(${scale})`;
            world.style.setProperty("--order", order.toFixed(4));
            world.style.setProperty("--zoom", scale.toFixed(4));
            leaf.style.setProperty("--progress", order.toFixed(3));

            world.style.willChange = "transform";
            clearTimeout(idle);
            idle = window.setTimeout(() => (world.style.willChange = "auto"), 200);
        };
        const schedule = () => (frame ||= requestAnimationFrame(update));
        const resize = () => {
            measure();
            schedule();
        };
        measure();
        update();
        addEventListener("scroll", schedule, { passive: true });
        addEventListener("resize", resize);
        phone.addEventListener("change", resize);
        document.addEventListener(
            "astro:before-swap",
            () => {
                cancelAnimationFrame(frame);
                removeEventListener("scroll", schedule);
                removeEventListener("resize", resize);
                phone.removeEventListener("change", resize);
            },
            { once: true },
        );
    }

    document.addEventListener("astro:page-load", initCollage);
</script>
